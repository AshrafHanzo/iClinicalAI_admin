# Copy this file to .env and fill in the real values (ask the team for them).

OPENAI_API_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/iclinical_db

# ─── Email (Titan Email / GoDaddy) ────────────────────────────────
EMAIL_PROVIDER=Titan Email (GoDaddy)
EMAIL=info@iclinical.ai
EMAIL_PASSWORD=
# Where form submissions are delivered (defaults to EMAIL if left blank)
CONTACT_RECIPIENT=info@iclinical.ai
# GoDaddy-provisioned Titan mailbox: use GoDaddy's relay, STARTTLS on 587.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=587
SMTP_USE_SSL=false
# Our own anti-spam cap on form emails per calendar day.
MAX_EMAILS_PER_DAY=2000
